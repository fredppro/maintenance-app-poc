// prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client"
  output   = "../generated/prisma"
}

model Equipment {
  id           String            @id @default(cuid())
  name         String            @unique
  category     String?
  tasks        MaintenanceTask[]
  createdAt    DateTime          @default(now())
}

model MaintenanceTask {
  id           String    @id @default(cuid())
  title        String
  description  String?
  type         TaskType  @default(PREVENTIVE)
  startTime    DateTime
  endTime      DateTime
  equipmentId  String
  equipment    Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  status       String    @default("scheduled") 
  assignments MaintenanceTaskAssignment[]
  materials   Material[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Material {
  id        String          @id @default(cuid())
  name      String
  reference String?
  quantity  Float
  unit      MaterialUnit    @default(PC)
  price     Decimal?        @db.Decimal(10, 2)
  taskId    String
  task      MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}


enum TaskType {
  PREVENTIVE
  INSPECTION
  CORRECTIVE
}

model MaintenanceTaskAssignment {
  id        String          @id @default(cuid())
  taskId    String
  workerId  String
  startTime DateTime?
  endTime   DateTime?
  task      MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  worker    Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@unique([taskId, workerId])
}

model Worker {
  id        String      @id @default(cuid())
  name      String
  email     String      @unique
  phone     String?
  type      WorkerType  @default(INTERNAL)
  vendorId  String?
  vendor    Vendor?     @relation(fields: [vendorId], references: [id])
  assignments MaintenanceTaskAssignment[]
  createdAt DateTime @default(now())
}

model Vendor {
  id        String   @id @default(cuid())
  name      String   @unique
  contact   String?
  email     String?
  workers   Worker[]
  createdAt DateTime @default(now())
}

enum WorkerType {
  INTERNAL
  EXTERNAL
}

enum MaterialUnit {
  // --- General Count & Packaging ---
  PC        // Piece / Unit (screws, bolts, filters, valves)
  BOX       // Box
  SET       // Set / Pack
  BAG       // Bag (sand, bulk fasteners, cable ties)
  ROLL      // Roll (tape, wires, gaskets)
  TUBE      // Tube (silicone, grease, adhesive)
  CAN       // Can / Spray (WD-40, cleaner)
  KIT       // Kit (O-ring repair kit, tool kit)
  PAIR      // Pair (gloves, matching components)

  // --- Volume & Fluids ---
  L         // Liters
  ML        // Milliliters
  GAL       // Gallons
  DRUM      // Drum (hydraulic oil, bulk fluids)

  // --- Mass & Weight ---
  G         // Grams
  KG        // Kilograms
  LB        // Pounds

  // --- Length & Distance ---
  MM        // Millimeters
  M         // Meters
  IN        // Inches
  FT        // Feet
}