{
  "name": "manusist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma migrate deploy && tsx scripts/db/provision-runtime-role.ts && next build",
    "start": "next start",
    "up": "docker compose --profile app up --build",
    "down": "docker compose --profile app down",
    "bootstrap": "tsx scripts/dev/bootstrap.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:rls": "vitest run src/lib/rls.integration.test.ts",
    "test:e2e": "playwright test",
    "test:legacy-ownership": "tsx scripts/legacy/verify-legacy-ownership.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test:run",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "db:e2e:up": "docker compose --profile e2e up -d --wait postgres-e2e",
    "db:e2e:down": "docker compose --profile e2e stop postgres-e2e",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:provision-role": "tsx scripts/db/provision-runtime-role.ts",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:e2e": "tsx scripts/db/migrate-e2e.ts",
    "db:seed": "prisma db seed",
    "db:verify-role": "tsx scripts/db/verify-runtime-role.ts",
    "db:backup": "sh scripts/db/backup/backup-db.sh",
    "db:restore-test": "sh scripts/db/backup/restore-test.sh",
    "ops:tenant": "tsx scripts/ops/tenant-admin.ts",
    "ops:purge-trash": "tsx scripts/ops/purge-trash.ts",
    "ops:retention": "tsx scripts/ops/retention.ts",
    "ops:privacy": "tsx scripts/ops/privacy-admin.ts",
    "legacy:assign-owner": "tsx scripts/legacy/assign-legacy-ownership.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
