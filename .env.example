# Local development database. Start it with `pnpm db:up`.
# The app connects as the restricted `maintenance_app_runtime` role so row-level security is enforced;
# migrations and seeding use the owner via MIGRATION_DATABASE_URL.
DATABASE_URL="postgresql://maintenance_app_runtime:maintenance_app_runtime@localhost:5432/maintenance_app?schema=public"
MIGRATION_DATABASE_URL="postgresql://maintenance_app:maintenance_app@localhost:5432/maintenance_app?schema=public"

# Dedicated local E2E database. Start it with `pnpm db:e2e:up`.
E2E_DATABASE_URL="postgresql://maintenance_app:maintenance_app@localhost:5433/maintenance_app_test?schema=public"
# Generate a unique auth secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Production only: Resend email delivery and the one-time initial owner account.
# RESEND_API_KEY=""
# AUTH_EMAIL_FROM="Maintenance Scheduler <accounts@example.com>"
# ALLOW_PUBLIC_SIGNUP="true"  # open sign-up in production (previews only)
# PILOT_BOOTSTRAP_EMAIL="pilot-owner@example.com"

# Optional: organization owner to receive development seed data.
# SEED_ADMIN_EMAIL="owner@example.com"

# File storage. Without S3_BUCKET, development falls back to local disk (.storage/).
# MinIO (see docker-compose `storage` profile): `docker compose --profile storage up -d minio minio-init`
# S3_ENDPOINT="http://localhost:9000"
# S3_BUCKET="maintenance-files"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="minioadmin"
# S3_SECRET_ACCESS_KEY="minioadmin"
# S3_FORCE_PATH_STYLE="true"
# Optional: local-disk directory used when S3_BUCKET is unset (default ".storage").
# STORAGE_LOCAL_DIR=".storage"

# Backups (used by scripts/backup/backup-db.sh and the backup workflow).
# BACKUP_DATABASE_URL="postgresql://owner:password@host/db"   # unpooled connection
# BACKUP_S3_URI="s3://offsite-backups/maintenance"
