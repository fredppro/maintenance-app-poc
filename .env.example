# Copy to .env for local development. These credentials are for the local
# Docker Compose services only; never reuse them in staging or production.
# Start PostgreSQL with `pnpm db:up`.
DATABASE_URL="postgresql://maintenance_app_runtime:maintenance_app_runtime@localhost:5432/maintenance_app?schema=public"
MIGRATION_DATABASE_URL="postgresql://maintenance_app:maintenance_app@localhost:5432/maintenance_app?schema=public"

# Separate local browser-test database; start with `pnpm db:e2e:up`.
E2E_DATABASE_URL="postgresql://maintenance_app:maintenance_app@localhost:5433/maintenance_app_test?schema=public"

# Required by the app. Generate a unique local value with `openssl rand -base64 32`.
BETTER_AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Optional; analytics is disabled unless set to "true".
NEXT_PUBLIC_ENABLE_ANALYTICS="false"

# Email and first-owner bootstrap: configure only in the deployed app when needed.
# Production readiness requires a verified Resend sender and these values.
# RESEND_API_KEY="replace-with-a-Resend-API-key"
# AUTH_EMAIL_FROM="Maintenance Scheduler <accounts@example.com>"
# PILOT_BOOTSTRAP_EMAIL="pilot-owner@example.com"

# Scheduled maintenance reminders. The app and scheduled caller must use the
# same secret. The caller sends Authorization: Bearer <CRON_SECRET>.
# Generate a separate value with `openssl rand -hex 32`.
# CRON_SECRET="replace-with-a-random-secret"

# Optional S3-compatible storage. Without S3_BUCKET, local development uses
# .storage/; production requires a bucket. For local MinIO, start the services
# with `docker compose --profile storage up -d minio minio-init`, then uncomment:
# S3_ENDPOINT="http://localhost:9000"
# S3_BUCKET="maintenance-files"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="minioadmin"
# S3_SECRET_ACCESS_KEY="minioadmin"
# S3_FORCE_PATH_STYLE="true"
# STORAGE_LOCAL_DIR=".storage"

# Optional, separate credentials for read-only bucket inventory.
# S3_AUDIT_ACCESS_KEY_ID=""
# S3_AUDIT_SECRET_ACCESS_KEY=""

# Optional, separate credentials for scheduled export-object cleanup.
# Required by the maintenance workflow when S3_BUCKET is configured.
# S3_CLEANUP_ACCESS_KEY_ID=""
# S3_CLEANUP_SECRET_ACCESS_KEY=""

# Optional development seed target. The owner must already exist locally.
# SEED_ADMIN_EMAIL="owner@example.com"

# Optional integration-test override. Use only a disposable migrated database
# with an administrative role; never point this at staging or production.
# RLS_TEST_DATABASE_URL="postgresql://<admin>:<password>@localhost:5433/maintenance_app_test?schema=public"

# Optional database backup workflow inputs. BACKUP_DATABASE_URL should use a
# direct/unpooled connection. BACKUP_S3_URI is needed for an off-host copy.
# Configure upload credentials only in the protected GitHub Environment.
# BACKUP_DATABASE_URL="postgresql://<backup-user>:<password>@<host>:5432/<database>?sslmode=require"
# BACKUP_S3_URI="s3://<private-backup-bucket>/<prefix>"
# BACKUP_AWS_ACCESS_KEY_ID=""
# BACKUP_AWS_SECRET_ACCESS_KEY=""
# BACKUP_AWS_REGION="eu-west-1"

# Vercel + Neon is a fallback, not the default. Vercel/Neon integrations may
# supply DATABASE_URL (runtime base) and DATABASE_URL_UNPOOLED (direct owner).
# In that environment, set MIGRATION_DATABASE_URL to an environment-scoped
# owner URL when needed. If configuring URLs manually, use placeholders like:
# DATABASE_URL_UNPOOLED="postgresql://<owner>:<password>@<direct-host>/<database>?sslmode=require"
# APP_DATABASE_URL="postgresql://<runtime-role>:<password>@<host>/<database>?sslmode=require"
# Replace the local DATABASE_URL/MIGRATION_DATABASE_URL above for that
# environment; do not keep both local and provider definitions active. Do not
# copy production values here or mix tenant-specific credentials into this file.
# Dedicated per-tenant database routing is not implemented; there are no
# tenant-specific database variables to configure.
