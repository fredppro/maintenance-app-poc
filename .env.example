# Local development database. Start it with `pnpm db:up`.
DATABASE_URL="postgresql://maintenance_app:maintenance_app@localhost:5432/maintenance_app?schema=public"

# Dedicated local E2E database. Start it with `pnpm db:e2e:up`.
E2E_DATABASE_URL="postgresql://maintenance_app:maintenance_app@localhost:5433/maintenance_app_test?schema=public"
# Generate a unique auth secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Optional: organization owner to receive development seed data.
# SEED_ADMIN_EMAIL="owner@example.com"
