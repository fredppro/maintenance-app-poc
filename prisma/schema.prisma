// prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client"
  output          = "./generated/prisma"
  previewFeatures = ["relationJoins"]
}

model Equipment {
  id                    String                          @id @default(cuid())
  name                  String
  category              String?
  imageFileId           String?
  sectionId             String?
  organizationId        String
  siteId                String
  deletedAt             DateTime?
  deletedById           String?
  organization          Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site                  Site                            @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Restrict)
  imageFile             StoredFile?                     @relation(fields: [imageFileId], references: [id], onDelete: SetNull)
  // Optional area within `site`. `imageFileId` and `sectionId` are single-column FKs because
  // SET NULL can't null just one column of a composite FK; the equipment_same_tenant trigger
  // enforces that both belong to the same organization.
  section               Section?                        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  tasks                 MaintenanceTask[]
  relocations           EquipmentRelocation[]
  maintenancePoints     EquipmentMaintenancePoint[]
  operatingHourReadings EquipmentOperatingHourReading[]
  createdAt             DateTime                        @default(now())

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@index([siteId, organizationId])
  @@index([sectionId])
  @@index([imageFileId])
  @@index([organizationId, deletedAt])
}

// Metadata for an object kept in S3-compatible storage; the bytes never live in Postgres.
model StoredFile {
  id                String           @id @default(cuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key               String           @unique
  filename          String
  contentType       String
  size              Int
  uploadedById      String?
  unattachedUntil   DateTime?
  equipment         Equipment[]
  organizationLogos TenantSettings[]
  createdAt         DateTime         @default(now())

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([unattachedUntil])
}

// Durable outbox for object deletion. It intentionally has no organization FK so
// cleanup survives tenant deletion; RLS still scopes application access by organizationId.
model StoredFileDeletion {
  id             String    @id @default(cuid())
  organizationId String
  key            String    @unique
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lastAttemptAt  DateTime?
  createdAt      DateTime  @default(now())

  @@index([nextAttemptAt, createdAt])
  @@index([organizationId, nextAttemptAt])
}

// A named area inside a site, e.g. "Boiler room" or "Line 2".
model Section {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  siteId         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site         @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)
  equipment      Equipment[]
  createdAt      DateTime     @default(now())

  @@unique([id, organizationId])
  @@unique([siteId, name])
}

// Append-only location history. Names are snapshots so history survives renames and deletions.
model EquipmentRelocation {
  id              String    @id @default(cuid())
  equipmentId     String
  organizationId  String
  equipment       Equipment @relation(fields: [equipmentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  fromSiteName    String?
  fromSectionName String?
  toSiteName      String
  toSectionName   String?
  movedById       String?
  movedAt         DateTime  @default(now())

  @@index([equipmentId, movedAt])
  @@index([organizationId])
}

model MaintenanceTask {
  id                 String                         @id @default(cuid())
  title              String
  description        String?
  type               TaskType                       @default(PREVENTIVE)
  startTime          DateTime
  endTime            DateTime?
  equipmentId        String
  maintenancePointId String?
  organizationId     String
  organization       Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  equipment          Equipment                      @relation(fields: [equipmentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  maintenancePoint   EquipmentMaintenancePoint?     @relation(fields: [maintenancePointId], references: [id], onDelete: SetNull)
  status             String                         @default("scheduled")
  completedAt        DateTime?
  assignments        MaintenanceTaskAssignment[]
  dailyHours         MaintenanceTaskDailyHours[]
  checklistItems     MaintenanceTaskChecklistItem[]
  inventoryMovements InventoryMovement[]
  reminders          MaintenanceTaskReminder[]
  materials          Material[]
  deletedAt          DateTime?
  deletedById        String?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId, startTime])
  @@index([organizationId, deletedAt])
}

model EquipmentMaintenancePoint {
  id             String                        @id @default(cuid())
  equipmentId    String
  organizationId String
  name           String
  description    String?
  sortOrder      Int                           @default(0)
  isActive       Boolean                       @default(true)
  equipment      Equipment                     @relation(fields: [equipmentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  checklistItems EquipmentPointChecklistItem[]
  tasks          MaintenanceTask[]
  createdAt      DateTime                      @default(now())

  @@unique([id, equipmentId, organizationId])
  @@unique([equipmentId, organizationId, name])
  @@index([organizationId, equipmentId, isActive])
}

model EquipmentPointChecklistItem {
  id             String                    @id @default(cuid())
  pointId        String
  equipmentId    String
  organizationId String
  title          String
  sortOrder      Int                       @default(0)
  isActive       Boolean                   @default(true)
  point          EquipmentMaintenancePoint @relation(fields: [pointId, equipmentId, organizationId], references: [id, equipmentId, organizationId], onDelete: Cascade)
  createdAt      DateTime                  @default(now())

  @@unique([id, organizationId])
  @@index([organizationId, pointId, isActive])
}

model MaintenanceTaskChecklistItem {
  id             String          @id @default(cuid())
  taskId         String
  organizationId String
  sourceItemId   String?
  title          String
  sortOrder      Int             @default(0)
  isComplete     Boolean         @default(false)
  completedAt    DateTime?
  completedById  String?
  task           MaintenanceTask @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdAt      DateTime        @default(now())

  @@unique([id, organizationId])
  @@index([organizationId, taskId, sortOrder])
}

model EquipmentOperatingHourReading {
  id             String    @id @default(cuid())
  equipmentId    String
  organizationId String
  reading        Decimal   @db.Decimal(12, 2)
  measuredAt     DateTime  @default(now())
  note           String?
  recordedById   String?
  equipment      Equipment @relation(fields: [equipmentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdAt      DateTime  @default(now())

  @@unique([id, organizationId])
  @@index([organizationId, equipmentId, measuredAt])
}

model Material {
  id             String          @id @default(cuid())
  name           String
  reference      String?
  quantity       Float
  unit           MaterialUnit    @default(PC)
  price          Decimal?        @db.Decimal(10, 2)
  taskId         String
  organizationId String
  task           MaintenanceTask @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)
}

model InventoryItem {
  id             String              @id @default(cuid())
  name           String
  reference      String?
  unit           MaterialUnit        @default(PC)
  onHand         Decimal             @default(0) @db.Decimal(12, 2)
  reorderPoint   Decimal             @default(0) @db.Decimal(12, 2)
  vendorId       String?
  siteId         String
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site                @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Restrict)
  vendor         Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  movements      InventoryMovement[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([id, organizationId])
  @@unique([siteId, organizationId, name])
  @@index([organizationId, siteId])
  @@index([organizationId, vendorId])
}

model InventoryMovement {
  id              String                @id @default(cuid())
  inventoryItemId String
  organizationId  String
  taskId          String?
  type            InventoryMovementType
  quantity        Decimal               @db.Decimal(12, 2)
  note            String?
  recordedById    String?
  inventoryItem   InventoryItem         @relation(fields: [inventoryItemId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task            MaintenanceTask?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt       DateTime              @default(now())

  @@unique([id, organizationId])
  @@index([organizationId, inventoryItemId, createdAt])
  @@index([organizationId, taskId])
}

model MaintenanceTaskReminder {
  id               String                          @id @default(cuid())
  taskId           String
  workerId         String
  organizationId   String
  notificationType MaintenanceTaskNotificationType @default(REMINDER)
  idempotencyKey   String                          @unique
  recipientEmail   String
  locale           String                          @default("en")
  scheduledFor     DateTime
  nextAttemptAt    DateTime
  status           MaintenanceReminderStatus       @default(PENDING)
  attempts         Int                             @default(0)
  lastAttemptAt    DateTime?
  sentAt           DateTime?
  lastError        String?
  requestedById    String?
  task             MaintenanceTask                 @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  worker           Worker                          @relation(fields: [workerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt

  @@index([organizationId, status, nextAttemptAt])
  @@index([taskId, organizationId, notificationType, scheduledFor])
}

enum InventoryMovementType {
  RECEIPT
  CONSUMPTION
  ADJUSTMENT
}

enum TaskType {
  PREDICTIVE
  PREVENTIVE
  CORRECTIVE
}

enum MaintenanceReminderStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum MaintenanceTaskNotificationType {
  ASSIGNMENT
  REMINDER
  MANUAL
}

model MaintenanceTaskAssignment {
  id             String          @id @default(cuid())
  taskId         String
  workerId       String
  organizationId String
  startTime      DateTime?
  endTime        DateTime?
  task           MaintenanceTask @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  worker         Worker          @relation(fields: [workerId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([taskId, workerId])
}

model MaintenanceTaskDailyHours {
  id             String          @id @default(cuid())
  taskId         String
  workerId       String
  organizationId String
  workDate       DateTime        @db.Date
  startTime      DateTime?
  hours          Decimal         @db.Decimal(4, 2)
  task           MaintenanceTask @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  worker         Worker          @relation(fields: [workerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdAt      DateTime        @default(now())

  @@index([organizationId, workDate])
  @@index([taskId, workerId])
}

model Worker {
  id             String                      @id @default(cuid())
  name           String
  email          String
  phone          String?
  type           WorkerType                  @default(INTERNAL)
  vendorId       String?
  organizationId String
  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor         Vendor?                     @relation(fields: [vendorId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assignments    MaintenanceTaskAssignment[]
  dailyHours     MaintenanceTaskDailyHours[]
  reminders      MaintenanceTaskReminder[]
  deletedAt      DateTime?
  deletedById    String?
  createdAt      DateTime                    @default(now())

  @@unique([id, organizationId])
  @@unique([organizationId, email])
  @@index([vendorId, organizationId])
  @@index([organizationId, deletedAt])
}

model Vendor {
  id             String          @id @default(cuid())
  name           String
  contact        String?
  email          String?
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workers        Worker[]
  inventoryItems InventoryItem[]
  createdAt      DateTime        @default(now())

  @@unique([id, organizationId])
  @@unique([organizationId, name])
}

enum WorkerType {
  INTERNAL
  EXTERNAL
}

enum MaterialUnit {
  // --- General Count & Packaging ---
  PC // Piece / Unit (screws, bolts, filters, valves)
  BOX // Box
  SET // Set / Pack
  BAG // Bag (sand, bulk fasteners, cable ties)
  ROLL // Roll (tape, wires, gaskets)
  TUBE // Tube (silicone, grease, adhesive)
  CAN // Can / Spray (WD-40, cleaner)
  KIT // Kit (O-ring repair kit, tool kit)
  PAIR // Pair (gloves, matching components)

  // --- Volume & Fluids ---
  L // Liters
  ML // Milliliters
  GAL // Gallons
  DRUM // Drum (hydraulic oil, bulk fluids)

  // --- Mass & Weight ---
  G // Grams
  KG // Kilograms
  LB // Pounds

  // --- Length & Distance ---
  MM // Millimeters
  M // Meters
  IN // Inches
  FT // Feet
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@index([lastRequest])
  @@map("rateLimit")
}

model Organization {
  id                 String                   @id
  name               String
  slug               String
  logo               String?
  createdAt          DateTime
  metadata           String?
  members            Member[]
  invitations        Invitation[]
  sites              Site[]
  sections           Section[]
  files              StoredFile[]
  equipment          Equipment[]
  tasks              MaintenanceTask[]
  workers            Worker[]
  vendors            Vendor[]
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  auditEvents        OrganizationAuditEvent[]
  settings           TenantSettings?
  exports            TenantExport[]

  @@unique([slug])
  @@map("organization")
}

model Site {
  id             String          @id @default(cuid())
  name           String
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  equipment      Equipment[]
  sections       Section[]
  inventoryItems InventoryItem[]
  createdAt      DateTime        @default(now())

  @@unique([id, organizationId])
  @@unique([organizationId, name])
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model LegacyOwnershipAssignment {
  id                     String   @id
  legacyOrganizationId   String   @unique
  siteId                 String
  ownerUserId            String
  operator               String
  ticket                 String
  organizationNameBefore String
  organizationSlugBefore String
  siteNameBefore         String
  assignedAt             DateTime @default(now())

  @@index([ownerUserId])
  @@map("legacy_ownership_assignment")
}

model OrganizationAuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId    String
  action         String
  subjectType    String
  subjectId      String
  details        Json         @default("{}")
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([subjectType, subjectId])
  @@map("organization_audit_event")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
}

// `pooled` tenants share the database; `dedicated` is reserved for tenants moved to their own database.
enum IsolationTier {
  POOLED
  DEDICATED
}

// One row per organization once its lifecycle is changed; a missing row means ACTIVE and POOLED.
model TenantSettings {
  organizationId        String        @id
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status                TenantStatus  @default(ACTIVE)
  isolationTier         IsolationTier @default(POOLED)
  statusReason          String?
  deletionRequestedAt   DateTime?
  deletionScheduledFor  DateTime?
  // Set when an owner or admin hides the "Getting started" checklist; applies to the whole organization.
  onboardingDismissedAt DateTime?
  // Company profile and regional defaults, edited by owners and admins. Null means "not set".
  contactEmail          String?
  contactPhone          String?
  timezone              String?
  locale                String?
  // The logo is a StoredFile of the same organization (enforced by the tenant_settings_same_tenant trigger).
  logoFileId            String?
  logoFile              StoredFile?   @relation(fields: [logoFileId], references: [id], onDelete: SetNull)
  updatedAt             DateTime      @updatedAt

  @@index([logoFileId])
  @@map("tenant_settings")
}

enum ExportStatus {
  PENDING
  RUNNING
  READY
  FAILED
}

model TenantExport {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedById  String
  status         ExportStatus @default(PENDING)
  leaseId        String?
  heartbeatAt    DateTime?
  fileKey        String?
  size           Int?
  error          String?
  createdAt      DateTime     @default(now())
  completedAt    DateTime?
  expiresAt      DateTime?

  @@index([organizationId, createdAt])
  @@map("tenant_export")
}

model TenantExportTempReservation {
  id             String   @id
  slot           Int      @unique
  organizationId String
  exportId       String   @unique
  reservedBytes  BigInt
  heartbeatAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([heartbeatAt])
  @@map("tenant_export_temp_reservation")
}
